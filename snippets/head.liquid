{% render 'layout-get-shella' %}

<style id="pwp-ux-ergonomics-fixes">
  /* Fix #1 & #18: Prevent horizontal overflow while preserving CSS sticky */
  html, body {
    overflow-x: clip !important;
    max-width: 100vw !important;
  }
  .collections > .overflow-hidden {
    overflow: visible !important;
  }
  .header__tape,
  .announcement-bar,
  .announcement-bar__content {
    min-width: 0 !important;
    max-width: 100% !important;
    overflow: hidden !important;
    white-space: normal !important;
    text-overflow: ellipsis !important;
  }

  /* Fix #39 & #42: Instant LCP Image Visibility & Zero-CLS Collection Aspect Ratio */
  .rimage__img {
    opacity: 1 !important;
    visibility: visible !important;
  }
  .product-collection__image {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .product-collection__image .pwp-hover-lifestyle-img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    opacity: 0 !important;
    transition: opacity 0.28s ease-in-out, transform 0.35s ease !important;
    pointer-events: none !important;
    z-index: 2 !important;
  }
  .product-collection__image:hover .pwp-hover-lifestyle-img,
  .product-collection:hover .pwp-hover-lifestyle-img {
    opacity: 1 !important;
    transform: scale(1.02) !important;
  }

  /* Fix #17: Compress Desktop Header Height (~143px instead of 220px) */
  @media (min-width: 1025px) {
    .header__line-additional {
      display: none !important;
    }
    .header__line-top {
      padding-top: 8px !important;
      padding-bottom: 8px !important;
      min-height: 68px !important;
    }
    .header__logo img {
      max-height: 56px !important;
      width: auto !important;
    }
  }

  /* Fix #36: Sticky Mobile Header Bar on Scroll */
  @media (max-width: 1024px) {
    .shopify-section-group-header-group,
    header.header,
    #shopify-section-header {
      position: sticky !important;
      top: 0 !important;
      z-index: 25 !important;
      background: #F6F4EF !important;
    }
  }

  /* Fix #15 & #16: Global & Mobile Ergonomic Touch Targets (>= 44-48px) */
  .header__btn-search,
  .header__btn-cart,
  .header__btn-menu {
    min-width: 44px !important;
    min-height: 44px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .input-quantity {
    min-height: 46px !important;
    display: inline-flex !important;
    align-items: center !important;
  }
  .input-quantity [data-control] {
    min-width: 44px !important;
    min-height: 44px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .input-quantity input {
    min-height: 44px !important;
  }
  .popup-cart__head [data-js-popup-close],
  .popup-cart__close,
  .product-cart__remove {
    min-width: 44px !important;
    min-height: 44px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .popup-cart__buttons a[href="/cart"],
  .popup-cart__buttons .btn-link {
    min-height: 44px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 8px 16px !important;
  }
  .tabs__btn,
  [data-js-tabs-btn],
  [data-js-tabs-btn-mobile] {
    min-height: 48px !important;
    padding-top: 12px !important;
    padding-bottom: 12px !important;
    display: inline-flex !important;
    align-items: center !important;
  }
  .collection-control__button-sidebar {
    min-height: 46px !important;
    padding: 8px 14px !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  /* Fix #26: iPhone Home-Bar Safe-Area Padding */
  .footbar-product,
  .popup-cart__buttons {
    padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px)) !important;
  }

  @media (max-width: 767px) {
    /* Fix #23: Prevent iOS Safari Auto-Zoom on Input Focus */
    input[type="text"],
    input[type="search"],
    input[type="email"],
    input[type="tel"],
    input[type="number"],
    select,
    textarea {
      font-size: 16px !important;
    }

    .header__tape {
      padding-left: 8px !important;
      padding-right: 8px !important;
      font-size: 11.5px !important;
      line-height: 1.25 !important;
      padding-top: 3px !important;
      padding-bottom: 3px !important;
    }

    /* Fix #22: Pull Mobile PDP "ADD TO CART" Above the 844px Fold (Zero-Scroll on 390x844) */
    .template-product .breadcrumbs {
      display: none !important;
    }
    .template-product .product-page {
      margin-top: 6px !important;
      padding-top: 0 !important;
    }
    .template-product .product-gallery__thumbnail {
      display: none !important;
    }
    .template-product .product-gallery__main,
    .template-product .product-gallery__main .product-gallery__main_item,
    .template-product .product-gallery__main .rimage {
      max-height: 255px !important;
      min-height: 255px !important;
      padding-top: 0 !important;
      height: 255px !important;
      overflow: hidden !important;
    }
    .template-product .product-gallery__main .rimage__img {
      object-fit: contain !important;
      max-height: 255px !important;
      width: 100% !important;
      height: 255px !important;
      position: relative !important;
    }
    .template-product .product-gallery {
      margin-bottom: 6px !important;
    }
    .template-product .product-page-info__labels,
    .template-product .product-page-info__price-sale-details {
      display: none !important;
    }
    .template-product .product-page-info__title {
      margin-bottom: 4px !important;
    }
    .template-product .product-page-info__title h1 {
      font-size: 17px !important;
      line-height: 1.25 !important;
      margin-bottom: 0 !important;
    }
    .template-product .product-page-info__price {
      margin-bottom: 6px !important;
    }
    .template-product .product-page-info__options {
      margin-bottom: 6px !important;
    }
    .template-product .product-options__section {
      margin-bottom: 0 !important;
    }
    .template-product #pwp-uk-metric-helper {
      margin-bottom: 6px !important;
      padding: 5px 8px !important;
      font-size: 12px !important;
    }
    .template-product .product-page-info__details-buttons {
      margin-bottom: 6px !important;
    }
    .template-product .product-page-info__field.mb-20,
    .template-product .product-page-info__quantity {
      margin-bottom: 8px !important;
    }

    /* Primary CTA buttons >= 48px on mobile */
    .product-page-info__button-add-to-cart .btn,
    .popup-cart__buttons .btn[name="checkout"],
    .product-collection__buttons .btn,
    .footbar-product__button-add-to-cart .btn {
      min-height: 48px !important;
      font-size: 14px !important;
      font-weight: 600 !important;
    }
    .product-options--type-page .product-options__value {
      min-height: 44px !important;
      min-width: 44px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 6px 12px !important;
      margin-bottom: 4px !important;
    }
    .product-page-info__details-buttons .btn-link {
      min-height: 44px !important;
      padding: 6px 6px !important;
      display: inline-flex !important;
      align-items: center !important;
    }

    /* Fix #33: Scannable 2-Column Mobile Collection Grid */
    .collection-body [data-js-products-grid] > [class*="col-"] {
      flex: 0 0 50% !important;
      max-width: 50% !important;
      padding-left: 6px !important;
      padding-right: 6px !important;
    }
    .product-collection__title h4,
    .product-collection__title a {
      font-size: 13px !important;
      line-height: 1.3 !important;
    }

    /* Fix #18: Sticky Mobile Collection Filter & Sort Bar */
    .collection-control {
      position: sticky !important;
      top: 0 !important;
      z-index: 15 !important;
      background: #F6F4EF !important;
      padding-top: 8px !important;
      padding-bottom: 8px !important;
      border-bottom: 1px solid #e5e5e5 !important;
    }

    /* Fix #13: Compact mobile layout for Sticky Add-to-Cart footbar */
    .footbar-product .footbar-product__image {
      margin-right: 10px !important;
      max-width: 44px !important;
    }
    .footbar-product .footbar-product__options label {
      display: none !important;
    }
    .footbar-product .footbar-product__options select {
      min-height: 40px !important;
      padding: 4px 24px 4px 8px !important;
      font-size: 16px !important;
    }
  }

  /* Fix #20: Hide duplicate third-party injected trust badge row */
  .ultimateTrustBadgesInnerContainer,
  #ultimate-trust-badges,
  .giraffly-trust-badge {
    display: none !important;
  }

  /* Clean spacing on price sale separator */
  .price--sale > span:first-child {
    margin-right: 4px;
  }
  .price--sale > span:last-child {
    margin-left: 4px;
  }
</style>
<script id="pwp-search-autofocus">
  /* Fix #32: Instant Keyboard Auto-Focus on Mobile Search Tap */
  document.addEventListener('click', function(e) {
    var searchBtn = e.target.closest('.header__btn-search');
    if (searchBtn) {
      setTimeout(function() {
        var input = document.querySelector('[data-js-popup-name="navigation"] input[type="search"], .popup-navigation input[type="search"], input[name="q"]');
        if (input) {
          input.focus();
        }
      }, 150);
    }
  });
</script>

