<script type="speculationrules">
{"prefetch":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/cart*","/checkout*","/account*","/*\\?*"]}}]},"eagerness":"moderate"}]}
</script>
<script id="pwp-instant-nav">
(function(){
  var prefetched = new Set();
  function prefetchUrl(el) {
    var a = el && el.closest ? el.closest('a[href]') : null;
    if (!a || !a.href) return;
    if (a.origin !== location.origin || a.pathname === location.pathname) return;
    if (/^\/(cart|checkout|account)/.test(a.pathname)) return;
    if (prefetched.has(a.href)) return;
    prefetched.add(a.href);
    var l = document.createElement('link');
    l.rel = 'prefetch';
    l.href = a.href;
    document.head.appendChild(l);
  }
  document.addEventListener('mouseover', function(e){ prefetchUrl(e.target); }, {passive: true});
  document.addEventListener('touchstart', function(e){ prefetchUrl(e.target); }, {passive: true});
})();
</script>
{%- if page.handle == 'desk-size-visualizer' or page.handle == 'free-4k-wallpapers' -%}
<script id="pwp-link-magnets-interactive">
document.addEventListener('click', function(e) {
  var btn = e.target.closest('.pwp-vis-btn');
  if (btn) {
    var group = btn.parentElement;
    Array.from(group.querySelectorAll('.pwp-vis-btn')).forEach(function(b) {
      b.classList.remove('is-active');
      b.style.background = '#fff';
      b.style.color = '#141414';
      b.style.border = '1px solid #cbd5e1';
      b.style.fontWeight = '400';
    });
    btn.classList.add('is-active');
    btn.style.background = '#141414';
    btn.style.color = '#fff';
    btn.style.border = '2px solid #141414';
    btn.style.fontWeight = '600';

    var deskBtn = document.querySelector('#pwp-desk-btns .is-active');
    var kbBtn = document.querySelector('#pwp-kb-btns .is-active');
    var matBtn = document.querySelector('#pwp-mat-btns .is-active');
    if (deskBtn && kbBtn && matBtn) {
      var dw = parseFloat(deskBtn.getAttribute('data-desk-w') || '140');
      var dd = parseFloat(deskBtn.getAttribute('data-desk-d') || '70');
      var kw = parseFloat(kbBtn.getAttribute('data-kb-w') || '36');
      var mw = parseFloat(matBtn.getAttribute('data-mat-w') || '80');
      var md = parseFloat(matBtn.getAttribute('data-mat-d') || '40');
      var sweepCm = Math.max(10, Math.round(mw - kw - 3));
      var sweepIn = (sweepCm / 2.54).toFixed(1);
      var mdIn = (md / 2.54).toFixed(1);
      var readout = document.getElementById('pwp-mouse-readout');
      if (readout) readout.textContent = sweepCm + ' cm (' + sweepIn + '") × ' + md + ' cm (' + mdIn + '")';
      var diagCm = document.getElementById('pwp-diagram-mouse-cm');
      if (diagCm) diagCm.textContent = sweepCm + ' cm / ' + sweepIn + '"';
      var caption = document.getElementById('pwp-desk-caption');
      if (caption) caption.textContent = 'Top-Down True Scale Diagram: ' + deskBtn.getAttribute('data-desk-label');
      var matBox = document.getElementById('pwp-mat-box');
      if (matBox) {
        matBox.style.width = Math.min(92, Math.round((mw / dw) * 100)) + '%';
        matBox.style.height = Math.min(82, Math.round((md / dd) * 100)) + '%';
      }
      var kbBox = document.getElementById('pwp-kb-box');
      if (kbBox) {
        kbBox.style.width = Math.min(72, Math.round((kw / mw) * 100)) + '%';
        kbBox.textContent = kbBtn.getAttribute('data-kb-label');
      }
    }

    var furnBtn = document.querySelector('#pwp-furn-btns .is-active');
    var canvasBtn = document.querySelector('#pwp-canvas-btns .is-active');
    var blanketBtn = document.querySelector('#pwp-blanket-btns .is-active');
    if (furnBtn && canvasBtn && blanketBtn) {
      var fw = parseFloat(furnBtn.getAttribute('data-furn-w') || '150');
      var cw = parseFloat(canvasBtn.getAttribute('data-canvas-w') || '76');
      var bw = parseFloat(blanketBtn.getAttribute('data-blanket-w') || '127');
      var cPct = Math.round((cw / fw) * 100);
      var bPct = Math.round((bw / fw) * 100);
      var wallReadout = document.getElementById('pwp-wall-readout');
      if (wallReadout) wallReadout.textContent = 'Wall Coverage: Canvas spans ' + cPct + '% of ' + furnBtn.getAttribute('data-furn-label') + ' • Blanket covers ' + bPct + '% of width';
      var cBox = document.getElementById('pwp-wall-canvas-box');
      if (cBox) {
        cBox.style.width = Math.min(88, Math.round((cw / fw) * 75)) + '%';
        cBox.textContent = cw + ' × ' + canvasBtn.getAttribute('data-canvas-h') + ' cm Canvas';
      }
      var fLabel = document.getElementById('pwp-furn-box-label');
      if (fLabel) fLabel.textContent = furnBtn.getAttribute('data-furn-label');
      var bBox = document.getElementById('pwp-blanket-drape-box');
      if (bBox) {
        bBox.style.width = Math.min(95, Math.round((bw / fw) * 75)) + '%';
        bBox.textContent = bw + ' × ' + blanketBtn.getAttribute('data-blanket-l') + ' cm Throw';
      }
    }
  }

  var copyEmbed = e.target.closest('#pwp-copy-embed-btn');
  if (copyEmbed) {
    var ta = document.getElementById('pwp-embed-code');
    if (ta && navigator.clipboard) {
      navigator.clipboard.writeText(ta.value);
      var st = document.getElementById('pwp-copy-embed-status');
      if (st) st.textContent = 'Copied to clipboard!';
    }
  }

  var copyCc = e.target.closest('.pwp-copy-cc-btn');
  if (copyCc) {
    var code = copyCc.getAttribute('data-cc-html') || '';
    if (navigator.clipboard) {
      navigator.clipboard.writeText(code);
      copyCc.textContent = 'Copied Attribution HTML!';
    }
  }
});
</script>
