<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ shop.url | append: pwp_clean_path | append: "#product" | json }},
  "name": {{ product.title | json }},
  "url": {{ pwp_prod_url | json }},
  "productID": {{ product.id | json }},
  "inProductGroupWithID": {{ product.id | append: "" | json }},
  "category": {{ product.type | default: "Home & Decor" | json }},
  "material": {{ product.metafields.custom.material_composition.value | default: pwp_material | json }},
  "additionalProperty": [
    {%- if product.metafields.descriptors.subtitle.value != blank -%}
    { "@type": "PropertyValue", "name": "Product Subtitle", "value": {{ product.metafields.descriptors.subtitle.value | json }} },
    {%- endif -%}
    {%- if product.metafields.custom.art_theme.value != blank -%}
    { "@type": "PropertyValue", "name": "Art Style & Theme", "value": {{ product.metafields.custom.art_theme.value | json }} },
    {%- endif -%}
    {%- if product.metafields.custom.dimensions_summary.value != blank -%}
    { "@type": "PropertyValue", "name": "Dimensions (Metric & Imperial)", "value": {{ product.metafields.custom.dimensions_summary.value | json }} },
    {%- endif -%}
    {%- if product.metafields.descriptors.care_guide.value != blank -%}
    { "@type": "PropertyValue", "name": "Care Instructions", "value": {{ product.metafields.descriptors.care_guide.value | json }} },
    {%- endif -%}
    { "@type": "PropertyValue", "name": "Production & Shipping", "value": "{% case localization.country.iso_code %}{% when 'US' %}Custom printed in the USA in 2–4 business days • Free Tracked US Shipping ($0.00 USD){% when 'CA' %}Custom printed in North America in 2–4 business days • Free Tracked Canada Shipping ($0.00 CAD){% when 'DE' or 'FR' or 'ES' or 'BE' or 'NL' %}Custom printed in Europe in 2–4 business days • Free Tracked EU Delivery (€0.00 EUR){% when 'CH' %}Custom printed in Europe in 2–4 business days • Free Tracked Swiss Delivery (0.00 CHF){% else %}Custom printed in the UK in 2–4 business days • Free Tracked UK Delivery (£0.00 GBP){% endcase %}" }
  ],
  {%- if product.media.size > 0 -%}
    "image": [
      {%- for media in product.media limit: 8 -%}
        {
          "@type": "ImageObject",
          "url": {{ media.preview_image | img_url: '2048x' | prepend: "https:" | json }},
          "contentUrl": {{ media.preview_image | img_url: '2048x' | prepend: "https:" | json }},
          "width": {{ media.preview_image.width | default: 2048 | json }},
          "height": {{ media.preview_image.height | default: 2048 | json }},
          "name": {{ media.alt | default: product.title | json }},
          "caption": {{ product.title | append: " — " | append: product.type | append: " by Prints With Passion" | json }},
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "acquireLicensePage": "https://printswithpassion.com/pages/free-4k-wallpapers",
          "creditText": "Prints With Passion Studio",
          "copyrightNotice": "© Prints With Passion",
          "creator": {
            "@type": "Organization",
            "name": "Prints With Passion"
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
  {%- elsif product.featured_image -%}
    "image": [
      {
        "@type": "ImageObject",
        "url": {{ product.featured_image | img_url: '2048x' | prepend: "https:" | json }},
        "contentUrl": {{ product.featured_image | img_url: '2048x' | prepend: "https:" | json }},
        "width": {{ product.featured_image.width | default: 2048 | json }},
        "height": {{ product.featured_image.height | default: 2048 | json }},
        "name": {{ product.title | json }},
        "license": "https://creativecommons.org/licenses/by/4.0/",
        "acquireLicensePage": "https://printswithpassion.com/pages/free-4k-wallpapers",
        "creditText": "Prints With Passion Studio",
        "copyrightNotice": "© Prints With Passion",
        "creator": {
          "@type": "Organization",
          "name": "Prints With Passion"
        }
      }
    ],
  {%- else -%}
    "image": ["https://cdn.shopify.com/s/files/1/0726/5039/1863/files/pwp_editorial_gallery_favicon_crest.jpg?v=1793472427"],
  {%- endif -%}
  {%- assign pwp_rev_count = product.metafields.reviews.rating_count | default: product.metafields.judgeme.all_reviews_count | default: product.metafields.loox.num_reviews | plus: 0 -%}
  {%- assign pwp_rev_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.judgeme.all_reviews_rating | default: product.metafields.loox.avg_rating -%}
  {%- if pwp_rev_val != blank and pwp_rev_count > 0 -%}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ pwp_rev_val | append: '' | json }},
      "reviewCount": {{ pwp_rev_count | json }},
      "bestRating": "5",
      "worstRating": "1"
    },
  {%- endif -%}
  {%- assign pwp_clean_desc = product.description | strip_html | strip -%}
  {%- if pwp_clean_desc == blank -%}
    {%- assign pwp_clean_desc = page_description | default: product.title | append: ' — Custom printed archival studio edition by Prints With Passion with free tracked delivery.' -%}
  {%- endif -%}
  "description": {{ pwp_clean_desc | json }},
  {%- assign pwp_main_sku = product.selected_or_first_available_variant.sku | default: product.selected_or_first_available_variant.id | append: '' -%}
  "sku": {{ pwp_main_sku | json }},
  "mpn": {{ pwp_main_sku | json }},
  "brand": {
    "@type": "Brand",
    "name": "Prints With Passion"
  },
  "itemCondition": "https://schema.org/NewCondition",
  "offers": [
    {%- assign pwp_offer_emitted = false -%}
    {%- for pwp_pass in (1..2) -%}
    {%- for variant in product.variants -%}
      {%- assign pwp_is_sel = false -%}
      {%- if pwp_sel_var and variant.id == pwp_sel_var.id -%}{%- assign pwp_is_sel = true -%}{%- endif -%}
      {%- if pwp_pass == 1 and pwp_is_sel == false -%}{%- continue -%}{%- endif -%}
      {%- if pwp_pass == 2 and pwp_is_sel == true -%}{%- continue -%}{%- endif -%}
      {%- if pwp_offer_emitted -%},{%- endif -%}
      {%- assign pwp_offer_emitted = true -%}
      {%- assign pwp_var_sku = variant.sku | default: variant.id | append: '' -%}
      {
        "@type": "Offer",
        "name": {{ variant.title | json }},
        "sku": {{ pwp_var_sku | json }},
        "mpn": {{ pwp_var_sku | json }},
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "price": "{{ variant.price | divided_by: 100 }}.{{ variant.price | modulo: 100 | prepend: '00' | slice: -2, 2 }}",
        "priceCurrency": "{{ cart.currency.iso_code | default: 'GBP' }}",
        "validFrom": "{{ product.published_at | default: product.created_at | date: '%Y-%m-%d' }}",
        "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
        "url": "{{ shop.url }}{{ pwp_clean_path }}?variant={{ variant.id }}",
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "0.00",
            "currency": "{{ cart.currency.iso_code | default: 'GBP' }}"
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "{{ localization.country.iso_code | default: 'GB' }}"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 2,
              "maxValue": 4,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 2,
              "maxValue": 4,
              "unitCode": "DAY"
            }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "{{ localization.country.iso_code | default: 'GB' }}",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 14,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
        }
      }
    {%- endfor -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<!-- PWP_MULTICHANNEL_META_START -->
{%- if template.name == 'product' -%}
  {%- assign pwp_cur_v = product.selected_or_first_available_variant -%}
  {%- assign pwp_v_price = pwp_cur_v.price | divided_by: 100 | append: '.' -%}
  {%- assign pwp_v_cents = pwp_cur_v.price | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
  {%- assign pwp_v_price_str = pwp_v_price | append: pwp_v_cents -%}
  {%- assign pwp_gcat = product.metafields['mm-google-shopping'].google_product_category.value | default: '500044' -%}
  {%- assign pwp_fbcat = product.metafields['mc-facebook'].google_product_category.value | default: pwp_gcat -%}
  <meta property="product:price:amount" content="{{ pwp_v_price_str }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: 'GBP' }}">
  {%- if pwp_cur_v.compare_at_price > pwp_cur_v.price -%}
    {%- assign pwp_cmp_price = pwp_cur_v.compare_at_price | divided_by: 100 | append: '.' -%}
    {%- assign pwp_cmp_cents = pwp_cur_v.compare_at_price | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
    <meta property="product:original_price:amount" content="{{ pwp_cmp_price }}{{ pwp_cmp_cents }}">
    <meta property="product:original_price:currency" content="{{ cart.currency.iso_code | default: 'GBP' }}">
    <meta property="product:sale_price:amount" content="{{ pwp_v_price_str }}">
    <meta property="product:sale_price:currency" content="{{ cart.currency.iso_code | default: 'GBP' }}">
  {%- endif -%}
  <meta property="product:availability" content="in stock">
  <meta property="og:availability" content="instock">
  <meta property="product:condition" content="new">
  <meta property="product:brand" content="Prints With Passion">
  <meta property="product:item_group_id" content="{{ product.id }}">
  <meta property="product:retailer_item_id" content="{{ pwp_cur_v.id }}">
  <meta property="product:retailer_part_no" content="{{ pwp_cur_v.sku | default: pwp_cur_v.id }}">
  <meta property="product:category" content="{{ pwp_gcat | escape }}">
  <meta property="product:google_product_category" content="{{ pwp_gcat | escape }}">
  <meta property="product:fb_product_category" content="{{ pwp_fbcat | escape }}">
  <meta property="product:gender" content="{{ product.metafields['mm-google-shopping'].gender.value | default: 'unisex' }}">
  <meta property="product:age_group" content="{{ product.metafields['mm-google-shopping'].age_group.value | default: 'adult' }}">
  <meta property="product:material" content="{{ product.metafields.custom.material_composition.value | default: pwp_material | escape }}">
  <meta property="product:custom_label_0" content="{{ product.type | default: 'Home & Decor' | escape }}">
  <meta property="product:custom_label_1" content="{{ product.metafields.custom.art_theme.value | default: 'Contemporary Art' | escape }}">
  <meta property="product:custom_label_2" content="{{ localization.country.iso_code | default: 'GB' }}_{{ cart.currency.iso_code | default: 'GBP' }}">
  <meta property="product:custom_label_3" content="Free Tracked Shipping">
  <meta property="product:custom_label_4" content="Custom Printed in UK, US & EU">
  <meta name="twitter:label1" content="Price">
  <meta name="twitter:data1" content="{{ cart.currency.symbol }}{{ pwp_v_price_str }} {{ cart.currency.iso_code }}">
  <meta name="twitter:label2" content="Shipping">
  <meta name="twitter:data2" content="{% case localization.country.iso_code %}{% when 'US' %}Free Tracked US Shipping ($0.00 USD){% when 'CA' %}Free Tracked Canada Shipping ($0.00 CAD){% when 'DE' or 'FR' or 'ES' or 'BE' or 'NL' %}Free Tracked EU Delivery (€0.00 EUR){% when 'CH' %}Free Tracked Swiss Delivery (0.00 CHF){% else %}Free Tracked UK Delivery (£0.00 GBP){% endcase %}">
  <script id="pwp-multichannel-pixel-bridge">
  (function() {
    var pwpVariants = {
      {%- for v in product.variants -%}
      "{{ v.id }}": {
        id: "{{ v.id }}",
        sku: {{ v.sku | default: v.id | json }},
        price: "{{ v.price | divided_by: 100 }}.{{ v.price | modulo: 100 | prepend: '00' | slice: -2, 2 }}",
        title: {{ v.title | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    };
    var pwpCurrency = {{ cart.currency.iso_code | default: 'GBP' | json }};
    var pwpProductId = "{{ product.id }}";
    var pwpProductTitle = {{ product.title | json }};
    var pwpProductCategory = {{ product.type | default: 'Home & Decor' | json }};
    var pwpInitialVid = "{{ pwp_cur_v.id }}";

    function fireViewVariant(vid) {
      var v = pwpVariants[String(vid)] || { id: vid, price: "{{ pwp_v_price_str }}", title: "" };
      var priceNum = parseFloat(v.price) || 0;
      var gmcId = "shopify_GB_" + pwpProductId + "_" + String(v.id);
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'view_item', {
          currency: pwpCurrency,
          value: priceNum,
          items: [{ item_id: gmcId, item_name: pwpProductTitle, item_category: pwpProductCategory, item_variant: v.title, price: priceNum, quantity: 1 }]
        });
      }
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'ViewContent', {
          content_ids: [String(v.id)],
          content_group_id: pwpProductId,
          content_name: pwpProductTitle,
          content_category: pwpProductCategory,
          content_type: 'product',
          value: priceNum,
          currency: pwpCurrency
        });
      }
      if (typeof window.ttq === 'object' && typeof window.ttq.track === 'function') {
        window.ttq.track('ViewContent', {
          content_id: String(v.id),
          content_name: pwpProductTitle,
          content_category: pwpProductCategory,
          content_type: 'product',
          value: priceNum,
          currency: pwpCurrency
        });
      }
      if (typeof window.pintrk === 'function') {
        window.pintrk('track', 'pagevisit', {
          value: priceNum,
          currency: pwpCurrency,
          line_items: [{ product_id: pwpProductId, product_variant_id: String(v.id), product_name: pwpProductTitle, product_category: pwpProductCategory, product_price: priceNum }]
        });
      }
    }

    function syncVariantMeta(vid) {
      var v = pwpVariants[String(vid)];
      if (!v) return;
      var mId = document.querySelector('meta[property="product:retailer_item_id"]');
      if (mId) mId.setAttribute('content', v.id);
      var mSku = document.querySelector('meta[property="product:retailer_part_no"]');
      if (mSku) mSku.setAttribute('content', v.sku);
      var mP1 = document.querySelector('meta[property="product:price:amount"]');
      if (mP1) mP1.setAttribute('content', v.price);
      var mP2 = document.querySelector('meta[property="og:price:amount"]');
      if (mP2) mP2.setAttribute('content', v.price);
      fireViewVariant(vid);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { fireViewVariant(pwpInitialVid); });
    } else {
      fireViewVariant(pwpInitialVid);
    }

    document.addEventListener('change', function(e) {
      if (e.target && e.target.name === 'id' && e.target.value) {
        syncVariantMeta(e.target.value);
      }
    });

    document.addEventListener('submit', function(e) {
      var form = e.target;
      if (form && form.action && form.action.indexOf('/cart/add') !== -1) {
        var idInput = form.querySelector('[name="id"]');
        var vid = idInput ? idInput.value : pwpInitialVid;
        var v = pwpVariants[String(vid)] || { id: vid, price: "{{ pwp_v_price_str }}", title: "" };
        var priceNum = parseFloat(v.price) || 0;
        var gmcId = "shopify_GB_" + pwpProductId + "_" + String(v.id);
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'add_to_cart', {
            currency: pwpCurrency,
            value: priceNum,
            items: [{ item_id: gmcId, item_name: pwpProductTitle, item_category: pwpProductCategory, item_variant: v.title, price: priceNum, quantity: 1 }]
          });
        }
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'AddToCart', {
            content_ids: [String(v.id)],
            content_group_id: pwpProductId,
            content_name: pwpProductTitle,
            content_category: pwpProductCategory,
            content_type: 'product',
            value: priceNum,
            currency: pwpCurrency
          });
        }
        if (typeof window.ttq === 'object' && typeof window.ttq.track === 'function') {
          window.ttq.track('AddToCart', {
            content_id: String(v.id),
            content_name: pwpProductTitle,
            content_category: pwpProductCategory,
            content_type: 'product',
            value: priceNum,
            currency: pwpCurrency
          });
        }
        if (typeof window.pintrk === 'function') {
          window.pintrk('track', 'addtocart', {
            value: priceNum,
            order_quantity: 1,
            currency: pwpCurrency,
            line_items: [{ product_id: pwpProductId, product_variant_id: String(v.id), product_name: pwpProductTitle, product_category: pwpProductCategory, product_price: priceNum }]
          });
        }
      }
    });
  })();
  </script>
{%- endif -%}
<!-- PWP_MULTICHANNEL_META_END -->
<script id="pwp-global-market-localizer">
  (function() {
    var country = {{ localization.country.iso_code | default: 'GB' | json }};
    var cfgMap = {
      'US': {
        bar: '🇺🇸 <span class="new-text">FREE Tracked US Shipping ($0.00 USD — Printed in the USA)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked US Shipping ($0.00 USD)',
        heading: 'FREE US TRACKED SHIPPING & LOCAL FULFILLMENT'
      },
      'CA': {
        bar: '🇨🇦 <span class="new-text">FREE Tracked Canada Shipping ($0.00 CAD — Fast North American Delivery)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked Canada Shipping ($0.00 CAD)',
        heading: 'FREE CANADA TRACKED SHIPPING ($0.00 CAD)'
      },
      'DE': {
        bar: '🇩🇪 <span class="new-text">FREE Tracked Germany Delivery (€0.00 EUR — Printed in Europe • Zero Customs)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked Germany Delivery (€0.00 EUR)',
        heading: 'FREE GERMANY & EU TRACKED DELIVERY (€0.00 EUR)'
      },
      'FR': {
        bar: '🇫🇷 <span class="new-text">FREE Tracked France Delivery (€0.00 EUR — Printed in Europe • Zero Customs)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked France Delivery (€0.00 EUR)',
        heading: 'FREE FRANCE & EU TRACKED DELIVERY (€0.00 EUR)'
      },
      'ES': {
        bar: '🇪🇸 <span class="new-text">FREE Tracked Spain Delivery (€0.00 EUR — Printed in Europe • Zero Customs)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked Spain Delivery (€0.00 EUR)',
        heading: 'FREE SPAIN & EU TRACKED DELIVERY (€0.00 EUR)'
      },
      'CH': {
        bar: '🇨🇭 <span class="new-text">FREE Tracked Switzerland Delivery (0.00 CHF — Fast European &amp; Swiss Delivery)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked Swiss Delivery (0.00 CHF)',
        heading: 'FREE SWITZERLAND TRACKED DELIVERY (0.00 CHF)'
      },
      'BE': {
        bar: '🇧🇪 <span class="new-text">FREE Tracked Belgium Delivery (€0.00 EUR — Printed in Europe • Zero Customs)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked Belgium Delivery (€0.00 EUR)',
        heading: 'FREE BELGIUM & EU TRACKED DELIVERY (€0.00 EUR)'
      },
      'NL': {
        bar: '🇳🇱 <span class="new-text">FREE Tracked Netherlands Delivery (€0.00 EUR — Printed in Europe • Zero Customs)</span> &nbsp;|&nbsp; <span class="shop-text">Buy Any 2 Tees &amp; Save 10% (Auto-Applied)</span>',
        badge: 'Free Tracked Netherlands Delivery (€0.00 EUR)',
        heading: 'FREE NETHERLANDS & EU TRACKED DELIVERY (€0.00 EUR)'
      }
    };
    function cleanInternalLinks() {
      document.querySelectorAll('a[href*="/products/"]').forEach(function(a) {
        var href = a.getAttribute('href');
        if (!href) return;
        // Strip nested /collections/.../products/ to canonical /products/
        if (href.indexOf('/collections/') !== -1 && href.indexOf('/products/') !== -1) {
          href = href.replace(/\/collections\/[^/]+\/products\//, '/products/');
        }
        // Strip internal search tracking params ?_pos=...&_sid=...&_ss=...
        if (href.indexOf('_pos=') !== -1 || href.indexOf('_sid=') !== -1) {
          href = href.split('?')[0];
        }
        a.setAttribute('href', href);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', cleanInternalLinks);
    } else {
      cleanInternalLinks();
    }
    var cfg = cfgMap[country];
    if (!cfg) return;
    function applyLocalization() {
      var bar = document.querySelector('.announcement-bar');
      if (bar) bar.innerHTML = cfg.bar;
      document.querySelectorAll('p, span, div, h4, h5, a').forEach(function(el) {
        if (el.children.length === 0 && el.textContent) {
          if (el.textContent.indexOf('Free Tracked UK Shipping (£0.00)') !== -1 || el.textContent.indexOf('Free Tracked US & UK Shipping') !== -1) {
            el.textContent = cfg.badge;
          }
          if (el.textContent.indexOf('FREE UK DELIVERY & DISPATCH') !== -1 || el.textContent.indexOf('FREE US & UK TRACKED DELIVERY') !== -1) {
            el.textContent = cfg.heading;
          }
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyLocalization);
    } else {
      applyLocalization();
    }
  })();
</script>

