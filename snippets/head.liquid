{%- endif -%}
{%- assign pwp_main_sku = product.selected_or_first_available_variant.sku | default: product.selected_or_first_available_variant.id | append: '' -%}
{%- if product.variants.size > 1 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "@id": {{ shop.url | append: pwp_clean_path | append: "#product" | json }},
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: pwp_clean_path | json }},
  "productGroupID": {{ product.id | append: "" | json }},
  "category": {{ product.type | default: "Home & Decor" | json }},
  "material": {{ product.metafields.custom.material_composition.value | default: pwp_material | json }},
  "description": {{ pwp_clean_desc | json }},
  "brand": {
    "@type": "Brand",
    "name": "Prints With Passion"
  },
  "variesBy": [
    {%- assign pwp_vby_color = false -%}
    {%- assign pwp_vby_size = false -%}
    {%- for opt in product.options_with_values -%}
      {%- assign opt_lc = opt.name | downcase -%}
      {%- if opt_lc contains 'color' or opt_lc contains 'colour' -%}{%- assign pwp_vby_color = true -%}
      {%- else -%}{%- assign pwp_vby_size = true -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if pwp_vby_size and pwp_vby_color -%}"https://schema.org/size", "https://schema.org/color"
    {%- elsif pwp_vby_color -%}"https://schema.org/color"
    {%- else -%}"https://schema.org/size"
    {%- endif -%}
  ],
  {%- if product.media.size > 0 -%}
    "image": [
      {%- for media in product.media limit: 8 -%}
        {
          "@type": "ImageObject",
          "url": {{ media.preview_image | img_url: '2048x' | prepend: "https:" | json }},
          "contentUrl": {{ media.preview_image | img_url: '2048x' | prepend: "https:" | json }},
          "width": {{ media.preview_image.width | default: 2048 | json }},
          "height": {{ media.preview_image.height | default: 2048 | json }},
          "name": {{ media.alt | default: product.title | json }},
          "caption": {{ product.title | append: " — " | append: product.type | append: " by Prints With Passion" | json }},
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "acquireLicensePage": "https://printswithpassion.com/pages/free-4k-wallpapers",
          "creditText": "Prints With Passion Studio",
          "copyrightNotice": "© Prints With Passion",
          "creator": { "@type": "Organization", "name": "Prints With Passion" }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
  {%- elsif product.featured_image -%}
    "image": [{{ product.featured_image | img_url: '2048x' | prepend: "https:" | json }}],
  {%- endif -%}
  {%- if pwp_rev_val != blank and pwp_rev_count > 0 -%}
