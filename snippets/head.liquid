<meta charset="utf-8">
{% include 'global-variables' %}
<script>
    if(!window.performance.mark) {
        window.performance.mark = a => a;
    }
    window.performance.mark('theme:DOM:load');
    {%- if request.design_mode -%}
        window.isDesignMode = true;
    {%- endif -%}
    window.theme = {};window.page = { default: {} };
</script>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="format-detection" content="telephone=no">
<meta name="theme-color" content="{{ settings.color_theme }}">
{%- assign get_canonical_url = canonical_url -%}
{%- if template.name == 'collection' and collection.handle != blank -%}
    {%- assign collectionURLEnd = 'collections/' | append: collection.handle -%}
    {%- assign canonical_url_split = get_canonical_url | split: collectionURLEnd -%}
    {%- assign get_canonical_url = canonical_url_split[0] | append: collectionURLEnd -%}
    {%- if current_tags == blank and current_page > 1 -%}
        {%- assign get_canonical_url = get_canonical_url | append: '?page=' | append: current_page -%}
    {%- endif -%}
{%- endif -%}
<link rel="canonical" href="{{ get_canonical_url }}">

{%- assign page_title_downcase = page.title | downcase -%}
{%- if template == 'page' and page_title_downcase contains 'include' -%}
    <meta name="robots" content="noindex">
{%- elsif template.name == 'search' or template.name == 'cart' or template.name contains 'customers' or template.name == '404' -%}
    <meta name="robots" content="noindex, follow">
{%- elsif template.name == 'collection' and current_tags != blank -%}
    <meta name="robots" content="noindex, follow">
{%- elsif template.name == 'collection' and collection.products_count == 0 -%}
    <meta name="robots" content="noindex, follow">
{%- elsif template.name == 'collection' and collection.handle == 'avada-upsell-best-sellers' -%}
    <meta name="robots" content="noindex, follow">
{%- elsif template.name == 'blog' and current_tags != blank -%}
    <meta name="robots" content="noindex, follow">
{%- elsif request.path contains '/tagged/' -%}
    <meta name="robots" content="noindex, follow">
{%- else -%}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endif -%}
{%- if settings.favicon != blank -%}
    <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
{%- endif -%}
{%- if template.name == 'index' -%}
    <title>Canvas Wall Art, XXL Desk Mats & Home Decor | Prints With Passion</title>
    <meta name="description" content="Shop archival framed canvas wall art (1.25&quot; pine bars), 4mm XXL stitched gaming desk mats, velvet cushion covers, plush throw blankets &amp; memory foam bath mats.">
{%- elsif template contains 'gift_card' -%}
    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
    {%- assign formatted_initial_value_stripped = formatted_initial_value | strip_html -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_initial_value_stripped, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">
{%- else -%}
    {%- capture pwp_brand_suffix -%}{%- unless page_title contains shop.name or page_title contains '|' or page_title.size > 46 %} | {{ shop.name }}{%- endunless -%}{%- endcapture -%}
    {%- capture clean_seo_title -%}{{ page_title | strip | replace: 'Free UK Delivery', 'Free Tracked Delivery' }}{%- if current_tags -%}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{%- endif -%}{%- if current_page != 1 %} &ndash; Page {{ current_page }}{%- endif -%}{{ pwp_brand_suffix }}{%- endcapture -%}
    <title>{{ clean_seo_title | strip }}</title>
    {%- if page_description -%}
        {%- assign raw_desc = page_description | strip_html | strip | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" -%}
        <meta name="description" content="{{ raw_desc | strip | escape }}">
    {%- endif -%}
{%- endif -%}
