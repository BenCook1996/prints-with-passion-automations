{%- if template.name == 'product' -%}
{%- assign pwp_material = "Premium Archival Print Material" -%}
{%- case product.type -%}
  {%- when "Desk Mats" -%}{%- assign pwp_material = "Micro-Woven Cloth Surface & 4mm Natural Non-Slip Rubber Base" -%}
  {%- when "Canvas Wall Art" -%}{%- assign pwp_material = "400gsm Archival Cotton-Poly Canvas & Kiln-Dried Pine Stretcher Frame" -%}
  {%- when "Cushion Covers" -%}{%- assign pwp_material = "Soft Brushed Poly-Linen with Concealed Zip" -%}
  {%- when "Throw Blankets" -%}{%- assign pwp_material = "300 GSM Ultra-Soft Anti-Pill Coral Fleece" -%}
  {%- when "Bath Mats" -%}{%- assign pwp_material = "Fast-Drying Velvet Microfibre & Cushioned Non-Slip Memory Foam" -%}
  {%- when "Graphic T-Shirts" -%}{%- assign pwp_material = "100% Ring-Spun Combed Cotton" -%}
  {%- when "Hoodies" -%}{%- assign pwp_material = "Heavyweight Brushed Cotton-Poly Fleece" -%}
{%- endcase -%}
{%- assign pwp_sel_var = product.selected_or_first_available_variant -%}
{%- assign pwp_clean_path = product.url | split: '?' | first -%}
{%- assign pwp_prod_url = shop.url | append: pwp_clean_path -%}
{%- if product.variants.size > 1 and pwp_sel_var -%}
  {%- assign pwp_prod_url = pwp_prod_url | append: '?variant=' | append: pwp_sel_var.id -%}
{%- endif -%}
