            "position": 1,
            "name": "Measure Your Primary Furniture Width (CM or Inches)",
            "text": "Measure the total width of your standing desk, gaming desk, sofa, or headboard in centimetres (cm) or inches."
          },
          {
            "@type": "HowToStep",
            "position": 2,
            "name": "Apply the 60% to 75% Architectural Proportion Formula",
            "text": "Multiply your furniture width by 0.65 to 0.75. For 140–160 cm (55–63") desks, select an 80×40 cm (31.5×15.5") XL or 91×46 cm (36×18") XXL desk mat. For 180–210 cm (70–82") sofas, select a 60×90 cm (24×36") or 75×100 cm (30×40") stretched canvas."
          },
          {
            "@type": "HowToStep",
            "position": 3,
            "name": "Preview Live Proportions & Browse Your Matched Collection",
            "text": "Toggle between Metric (cm) and Imperial (inches) inside the interactive visualizer and click directly into your matched Smart Sub-Collection."
          }
        ]
      }
    ]
  }
  </script>
{%- elsif template.name == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "@id": {{ shop.url | append: article.url | append: "#breadcrumb" | json }},
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Prints With Passion",
            "item": {{ shop.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | default: "Interior & Setup Guides" | json }},
            "item": {{ shop.url | append: blog.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": {{ shop.url | append: article.url | json }}
          }
        ]
      },
      {
        "@type": "BlogPosting",
        "@id": {{ shop.url | append: article.url | append: "#article" | json }},
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": {{ shop.url | append: article.url | json }}
        },
        "headline": {{ article.title | truncate: 110, "" | json }},
        "name": {{ article.title | json }},
        "description": {{ article.excerpt_or_content | strip_html | strip | truncate: 160, "" | json }},
        "url": {{ shop.url | append: article.url | json }},
        "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%SZ" | json }},
        "dateModified": {{ article.updated_at | default: article.published_at | date: "%Y-%m-%dT%H:%M:%SZ" | json }},
        "author": {
          "@type": "Organization",
          "name": {{ article.author | default: "Prints With Passion Studio" | json }},
          "url": {{ shop.url | json }}
        },
        "publisher": {
          "@type": "Organization",
          "name": "Prints With Passion",
          "url": {{ shop.url | json }},
          "logo": {
            "@type": "ImageObject",
            "url": "https://cdn.shopify.com/s/files/1/0726/5039/1863/files/pwp_editorial_gallery_favicon_crest.jpg?v=1793472427"
          }
        }{%- if article.image -%},
        "image": {
          "@type": "ImageObject",
          "url": {{ article.image | img_url: '1200x' | prepend: "https:" | json }},
          "contentUrl": {{ article.image | img_url: '2048x' | prepend: "https:" | json }},
          "name": {{ article.image.alt | default: article.title | json }},
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "acquireLicensePage": "https://printswithpassion.com/pages/free-4k-wallpapers",
          "creditText": "Prints With Passion Studio",
          "copyrightNotice": "© Prints With Passion",
          "creator": {
            "@type": "Organization",
            "name": "Prints With Passion"
          }
        }
        {%- endif -%}
      }
    ]
  }
  </script>
{%- endif -%}
