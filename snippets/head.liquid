{%- elsif template.name == 'index' -%}
  <link rel="preload" as="image" href="https://cdn.shopify.com/s/files/1/0726/5039/1863/files/lauterbrunnen-valley-switzerland-steep-cliffs-gallery-wrapped-stretched-can-context.jpg?v=1793136534&width=1200" imagesrcset="https://cdn.shopify.com/s/files/1/0726/5039/1863/files/lauterbrunnen-valley-switzerland-steep-cliffs-gallery-wrapped-stretched-can-context.jpg?v=1793136534&width=600 600w, https://cdn.shopify.com/s/files/1/0726/5039/1863/files/lauterbrunnen-valley-switzerland-steep-cliffs-gallery-wrapped-stretched-can-context.jpg?v=1793136534&width=900 900w, https://cdn.shopify.com/s/files/1/0726/5039/1863/files/lauterbrunnen-valley-switzerland-steep-cliffs-gallery-wrapped-stretched-can-context.jpg?v=1793136534&width=1400 1400w" imagesizes="(max-width: 767px) 96vw, (max-width: 1200px) 92vw, 720px" fetchpriority="high">
