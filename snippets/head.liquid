      {%- assign pwp_faq_dims = 'Available in 24×17 inches (61×43 cm Standard Vanity) and 34×21 inches (86×53 cm Large Tub Span) with a high-recovery memory foam core and non-skid SBR backing.' -%}
      {%- assign pwp_faq_care = 'Wash cold on a gentle cycle or hand-wash with mild soap, then air-dry flat to protect the non-skid SBR backing.' -%}
    {%- when 'Graphic T-Shirts' -%}
      {%- assign pwp_parent_col_url = '/collections/t-shirts' -%}
      {%- assign pwp_parent_col_name = 'Unisex Heavyweight Graphic Cotton T-Shirts' -%}
      {%- assign pwp_faq_dims = 'Available in Unisex sizes S, M, L, XL, 2XL, and 3XL crafted from breathable heavyweight 100% ring-spun combed cotton with archival DTG graphic print.' -%}
