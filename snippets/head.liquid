  .pwp-craft-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pwp-craft-card {
    background: var(--pwp-card);
    border: 1px solid var(--pwp-border);
    padding: 20px;
  }
  .pwp-craft-card h3 {
    font-family: var(--pwp-font-display) !important;
    font-size: 21px !important;
    margin: 0 0 6px 0 !important;
  }
  .pwp-craft-card p {
    font-size: 13.5px;
    color: var(--pwp-ink-secondary);
    margin: 0;
    line-height: 1.5;
  }
  .pwp-craft-img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--pwp-border);
  }

  /* Collection Tabs, Product Cards & Buttons (Editorial Gallery Minimalist) */
  .sorting-collections__head a,
  .tabs__btn {
    font-family: var(--pwp-font-sans) !important;
    font-weight: 600 !important;
    border-radius: 0 !important;
  }
  .product-collection {
    background: var(--pwp-card) !important;
    border: 1px solid var(--pwp-border) !important;
    padding: 12px !important;
    transition: border-color 180ms ease !important;
  }
  .product-collection:hover {
    border-color: var(--pwp-ink) !important;
  }
  .product-collection__title h4,
  .product-collection__title a {
    font-family: var(--pwp-font-display) !important;
    font-size: 19px !important;
    font-weight: 600 !important;
    line-height: 1.2 !important;
    color: var(--pwp-ink) !important;
  }
  .price, .price span {
    font-family: var(--pwp-font-sans) !important;
    font-variant-numeric: tabular-nums !important;
    font-weight: 700 !important;
    color: var(--pwp-ink) !important;
  }
  .btn,
  .product-page-info__button-add-to-cart .btn,
  .product-collection__buttons .btn {
    border-radius: 0 !important;
    font-family: var(--pwp-font-sans) !important;
    font-weight: 700 !important;
    letter-spacing: 0.01em !important;
  }
  .product-page-info__button-add-to-cart .btn {
    background-color: var(--pwp-accent) !important;
    border-color: var(--pwp-accent) !important;
    color: #FFFFFF !important;
    min-height: 54px !important;
  }
  .product-page-info__button-add-to-cart .btn:hover {
    background-color: var(--pwp-accent-hover) !important;
    border-color: var(--pwp-accent-hover) !important;
  }

  /* Footer Gallery Elevation */
  footer.footer,
  #shopify-section-footer {
    background-color: var(--pwp-bg-elevated) !important;
    border-top: 1px solid var(--pwp-border) !important;
    color: var(--pwp-ink) !important;
  }

  @media (max-width: 1024px) {
    .pwp-gallery-hero__grid,
    .pwp-craft-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .pwp-suite-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .pwp-suite-grid,
    .pwp-craft-cards {
      grid-template-columns: 1fr;
    }
    .pwp-gallery-hero {
      padding: 24px 0 40px;
    }
    .pwp-mode-pills {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }
    .pwp-mode-chip {
      flex-shrink: 0;
      min-height: 42px;
      padding: 6px 12px;
    }
    input[type="search"],
    input[type="text"],
    input[type="email"],
    select {
      font-size: 16px !important;
    }
  }
  @media (min-width: 1600px) {
    .pwp-gallery-hero__container {
      max-width: 1520px;
    }
  }
  /* Geo-Targeted Studio Pill */
  .pwp-geo-studio-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--pwp-font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--pwp-ink);
    background: var(--pwp-card);
    border: 1px solid var(--pwp-border);
    padding: 6px 12px;
    margin-bottom: 16px;
  }
  /* Touch vs Mouse Pointer Adaptation */
  @media (hover: none) and (pointer: coarse) {
    .pwp-split-knob {
      width: 48px !important;
      height: 48px !important;
      font-size: 18px !important;
    }
    .pwp-suite-btn {
      min-height: 52px !important;
    }
  }
  /* iOS Safe Area Bottom Bar Adaptation */
  html[data-pwp-os="ios"] .footbar {
    padding-bottom: env(safe-area-inset-bottom, 12px) !important;
  }
  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
<meta name="theme-color" content="#F6F4EF">
<script id="pwp-curatorial-hero-engine">
(function() {
  // 1. Dynamic Device, Input Modality, OS Platform & Location Detection
  function detectEnvironment() {
    var docEl = document.documentElement;
    var w = window.innerWidth || 1280;
    var device = w <= 640 ? 'mobile' : (w <= 1024 ? 'tablet' : (w >= 1600 ? 'ultrawide' : 'desktop'));
    var isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || (window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
    var ua = navigator.userAgent || '';
    var os = 'other';
    if (/iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
      os = 'ios';
    } else if (/Android/i.test(ua)) {
      os = 'android';
    } else if (/Mac/i.test(navigator.platform || ua)) {
      os = 'macos';
    } else if (/Win/i.test(navigator.platform || ua)) {
      os = 'windows';
    } else if (/Linux/i.test(navigator.platform || ua)) {
      os = 'linux';
    }
    docEl.setAttribute('data-pwp-device', device);
    docEl.setAttribute('data-pwp-input', isTouch ? 'touch' : 'mouse');
    docEl.setAttribute('data-pwp-os', os);
    docEl.setAttribute('data-pwp-dpr', String(Math.min(3, Math.round(window.devicePixelRatio || 1))));

    var hintEl = document.getElementById('pwp-hero-modality-hint');
    if (hintEl) {
      hintEl.textContent = isTouch
        ? 'Touch & drag split curtain or tap a medium below'
        : 'Drag slider above or select a substrate below';
    }

    var country = (window.Shopify && window.Shopify.country) || docEl.getAttribute('data-pwp-country') || '';
    if (!country) {
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (tz.indexOf('London') !== -1 || tz.indexOf('Belfast') !== -1) country = 'GB';
        else if (tz.indexOf('Toronto') !== -1 || tz.indexOf('Vancouver') !== -1) country = 'CA';
        else if (tz.indexOf('Zurich') !== -1) country = 'CH';
        else if (tz.indexOf('Sydney') !== -1 || tz.indexOf('Melbourne') !== -1) country = 'AU';
        else if (tz.indexOf('Europe/') === 0) country = 'EU';
        else country = 'US';
      } catch (e) { country = 'US'; }
    }
    docEl.setAttribute('data-pwp-country', country);
  }

  detectEnvironment();
  window.addEventListener('resize', detectEnvironment, { passive: true });

  // 2. Zero-Visual-Change Deferred Hover Image Hydration (Cuts Initial Grid Bandwidth by 50%)
  function hydrateHoverImg(img) {
    if (!img || img.dataset.pwpHydrated) return;
    img.dataset.pwpHydrated = '1';
    var hSrcset = img.getAttribute('data-hover-srcset');
    var hSizes = img.getAttribute('data-hover-sizes');
    var hSrc = img.getAttribute('data-hover-src');
    if (hSizes) img.setAttribute('sizes', hSizes);
    if (hSrcset) img.setAttribute('srcset', hSrcset);
    if (hSrc) img.setAttribute('src', hSrc);
  }

  document.addEventListener('pointerenter', function(e) {
    if (!e.target || !e.target.closest) return;
    var card = e.target.closest('.product-collection, [data-js-product-image]');
    if (card) {
      var hoverImg = card.querySelector('.pwp-hover-lifestyle-img');
      if (hoverImg) hydrateHoverImg(hoverImg);
    }
  }, true);

  document.addEventListener('mouseover', function(e) {
    if (!e.target || !e.target.closest) return;
    var card = e.target.closest('.product-collection, [data-js-product-image]');
    if (card) {
      var hoverImg = card.querySelector('.pwp-hover-lifestyle-img');
      if (hoverImg) hydrateHoverImg(hoverImg);
    }
  }, { passive: true });

  // Pre-hydrate visible hover images during browser idle time on desktop (hover-capable) devices after primary images finish loading
  window.addEventListener('load', function() {
    if (window.matchMedia && window.matchMedia('(hover: hover)').matches) {
      var scheduleIdle = window.requestIdleCallback || function(cb) { setTimeout(cb, 250); };
      scheduleIdle(function() {
        if ('IntersectionObserver' in window) {
          var hoverObserver = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                hydrateHoverImg(entry.target);
                obs.unobserve(entry.target);
              }
            });
          }, { rootMargin: '250px 0px' });
          document.querySelectorAll('.pwp-hover-lifestyle-img:not([data-pwp-hydrated])').forEach(function(img) {
            hoverObserver.observe(img);
          });
        }
      });
    }
  });

  function buildSrcset(baseUrl) {
    if (!baseUrl) return '';
    var sep = baseUrl.indexOf('?') !== -1 ? '&' : '?';
    return baseUrl + sep + 'width=600 600w, ' + baseUrl + sep + 'width=900 900w, ' + baseUrl + sep + 'width=1400 1400w';
  }

  function ensureLoupeBg(lens) {
    if (!lens) return;
    var bgUrl = lens.getAttribute('data-loupe-bg');
    if (bgUrl && !lens.style.backgroundImage) {
      lens.style.backgroundImage = "url('" + bgUrl + "')";
    }
  }

  function initPwpCuratorialHero() {
    detectEnvironment();
    var stage = document.getElementById('pwp-hero-stage-frame');
    if (!stage || stage.dataset.pwpBound) return;
    stage.dataset.pwpBound = '1';

    var handle = document.getElementById('pwp-hero-split-handle');
    var lens = document.getElementById('pwp-hero-loupe-lens');
    var tagLeft = document.getElementById('pwp-hero-tag-left');
    var tagRight = document.getElementById('pwp-hero-tag-right');
    var currentMode = 'split';
    var splitPct = 52;
    var dragging = false;

    function setSplit(pct) {
      splitPct = Math.max(0, Math.min(100, pct));
      stage.style.setProperty('--pwp-split', splitPct + '%');
      if (handle) handle.setAttribute('aria-valuenow', String(Math.round(splitPct)));
    }

    function setMode(mode) {
      currentMode = mode;
      document.querySelectorAll('[data-pwp-mode]').forEach(function(b) {
        b.classList.toggle('is-active', b.getAttribute('data-pwp-mode') === mode);
      });
      stage.classList.toggle('loupe-active', mode === 'loupe');
      stage.classList.toggle('loupe-pinned', mode === 'loupe');

      if (mode === 'split') {
        setSplit(50);
        if (handle) handle.style.display = 'block';
        if (tagLeft) tagLeft.style.display = 'block';
        if (tagRight) tagRight.style.display = 'block';
      } else if (mode === 'room') {
        setSplit(100);
        if (handle) handle.style.display = 'none';
        if (tagLeft) tagLeft.style.display = 'block';
        if (tagRight) tagRight.style.display = 'none';
      } else if (mode === 'studio') {
        setSplit(0);
        if (handle) handle.style.display = 'none';
        if (tagLeft) tagLeft.style.display = 'none';
        if (tagRight) tagRight.style.display = 'block';
      } else if (mode === 'loupe') {
        setSplit(0);
        if (handle) handle.style.display = 'none';
        if (lens) {
          ensureLoupeBg(lens);
          lens.style.left = '52%';
          lens.style.top = '48%';
          lens.style.backgroundPosition = '52% 48%';
        }
      }
    }

    document.addEventListener('click', function(e) {
      var modeBtn = e.target.closest('[data-pwp-mode]');
      if (modeBtn) {
        setMode(modeBtn.getAttribute('data-pwp-mode'));
        return;
      }
      var suiteBtn = e.target.closest('[data-pwp-suite]');
      if (suiteBtn) {
        document.querySelectorAll('[data-pwp-suite]').forEach(function(b) {
          b.classList.toggle('is-active', b === suiteBtn);
        });
        var roomImg = document.getElementById('pwp-hero-img-room');
        var frontImg = document.getElementById('pwp-hero-img-front');
        var titleEl = document.getElementById('pwp-hero-plaque-title');
        var bpEl = document.getElementById('pwp-hero-plaque-bp');
        var ctaEl = document.getElementById('pwp-hero-suite-cta');
        var rUrl = suiteBtn.getAttribute('data-room');
        var fUrl = suiteBtn.getAttribute('data-front');
        if (roomImg && rUrl) {
          roomImg.src = rUrl + '&width=1200';
          roomImg.srcset = buildSrcset(rUrl);
        }
        if (frontImg && fUrl) {
          frontImg.src = fUrl + '&width=1200';
          frontImg.srcset = buildSrcset(fUrl);
        }
        if (lens && fUrl) {
          var sep = fUrl.indexOf('?') !== -1 ? '&' : '?';
          var hiRes = fUrl + sep + 'width=2048';
          lens.setAttribute('data-loupe-bg', hiRes);
          if (currentMode === 'loupe' || lens.style.backgroundImage) {
            lens.style.backgroundImage = "url('" + hiRes + "')";
          }
        }
        if (titleEl) titleEl.textContent = suiteBtn.getAttribute('data-title');
        if (bpEl) bpEl.textContent = suiteBtn.getAttribute('data-bp');
        if (ctaEl) {
          ctaEl.href = suiteBtn.getAttribute('data-url');
          ctaEl.textContent = suiteBtn.getAttribute('data-cta');
        }
      }
    });

    function updatePointer(clientX, clientY) {
      var rect = stage.getBoundingClientRect();
      var x = ((clientX - rect.left) / rect.width) * 100;
      var y = ((clientY - rect.top) / rect.height) * 100;
      if (currentMode === 'loupe' && lens) {
        ensureLoupeBg(lens);
        stage.classList.remove('loupe-pinned');
        var cx = Math.max(8, Math.min(92, x));
        var cy = Math.max(8, Math.min(92, y));
        lens.style.left = cx + '%';
        lens.style.top = cy + '%';
        lens.style.backgroundPosition = cx + '% ' + cy + '%';
        return;
      }
      if (dragging && currentMode === 'split') {
        setSplit(x);
      }
    }

    stage.addEventListener('pointerdown', function(e) {
      if (currentMode === 'loupe') return;
      if (currentMode !== 'split') setMode('split');
      dragging = true;
      if (stage.setPointerCapture) stage.setPointerCapture(e.pointerId);
      updatePointer(e.clientX, e.clientY);
    });
    stage.addEventListener('pointermove', function(e) {
      if (currentMode === 'loupe' || dragging) {
        updatePointer(e.clientX, e.clientY);
      }
    });
    stage.addEventListener('pointerup', function() { dragging = false; });
    stage.addEventListener('pointercancel', function() { dragging = false; });

    if (handle) {
      handle.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); setSplit(splitPct - 5); }
        if (e.key === 'ArrowRight') { e.preventDefault(); setSplit(splitPct + 5); }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPwpCuratorialHero);
  } else {
    initPwpCuratorialHero();
  }
})();
</script>
