      "reviewCount": {{ pwp_rev_count | json }},
      "bestRating": "5",
      "worstRating": "1"
    },
  {%- endif -%}
  "hasVariant": [
    {%- assign pwp_var_emitted = false -%}
    {%- for pwp_pass in (1..2) -%}
    {%- for variant in product.variants -%}
      {%- assign pwp_is_sel = false -%}
      {%- if pwp_sel_var and variant.id == pwp_sel_var.id -%}{%- assign pwp_is_sel = true -%}{%- endif -%}
      {%- if pwp_pass == 1 and pwp_is_sel == false -%}{%- continue -%}{%- endif -%}
      {%- if pwp_pass == 2 and pwp_is_sel == true -%}{%- continue -%}{%- endif -%}
      {%- if pwp_var_emitted -%},{%- endif -%}
      {%- assign pwp_var_emitted = true -%}
      {%- assign pwp_var_sku = variant.sku | default: variant.id | append: '' -%}
      {%- assign pwp_v_price_str = variant.price | divided_by: 100 | append: '.' -%}
      {%- assign pwp_v_cents_str = variant.price | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
      {%- assign pwp_v_img = variant.featured_image | default: product.featured_image -%}
      {
        "@type": "Product",
        "@id": "{{ shop.url }}{{ pwp_clean_path }}?variant={{ variant.id }}#variant",
        "name": {{ product.title | append: " — " | append: variant.title | json }},
        "url": "{{ shop.url }}{{ pwp_clean_path }}?variant={{ variant.id }}",
        "sku": {{ pwp_var_sku | json }},
        "mpn": {{ pwp_var_sku | json }},
        "size": {{ variant.title | json }},
        "description": {{ pwp_clean_desc | json }},
        "brand": { "@type": "Brand", "name": "Prints With Passion" },
        {%- if pwp_v_img -%}
        "image": {{ pwp_v_img | img_url: '2048x' | prepend: "https:" | json }},
        {%- endif -%}
        "offers": {
          "@type": "Offer",
          "name": {{ variant.title | json }},
          "sku": {{ pwp_var_sku | json }},
          "availability": "https://schema.org/InStock",
          "itemCondition": "https://schema.org/NewCondition",
          "price": "{{ pwp_v_price_str }}{{ pwp_v_cents_str }}",
          "priceCurrency": "{{ cart.currency.iso_code | default: 'GBP' }}",
          {%- if variant.compare_at_price > variant.price -%}
          {%- assign pwp_cmp_p = variant.compare_at_price | divided_by: 100 | append: '.' -%}
          {%- assign pwp_cmp_c = variant.compare_at_price | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
          "priceSpecification": [
            {
              "@type": "UnitPriceSpecification",
              "price": "{{ pwp_v_price_str }}{{ pwp_v_cents_str }}",
              "priceCurrency": "{{ cart.currency.iso_code | default: 'GBP' }}"
            },
            {
              "@type": "UnitPriceSpecification",
              "priceType": "https://schema.org/StrikethroughPrice",
              "price": "{{ pwp_cmp_p }}{{ pwp_cmp_c }}",
              "priceCurrency": "{{ cart.currency.iso_code | default: 'GBP' }}"
            }
          ],
          {%- endif -%}
          "validFrom": "{{ product.published_at | default: product.created_at | date: '%Y-%m-%d' }}",
          "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
          "url": "{{ shop.url }}{{ pwp_clean_path }}?variant={{ variant.id }}",
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": "0.00", "currency": "{{ cart.currency.iso_code | default: 'GBP' }}" },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "{{ localization.country.iso_code | default: 'GB' }}" },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 3, "unitCode": "DAY" }
            }
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "{{ localization.country.iso_code | default: 'GB' }}",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 14,
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
          }
        }
      }
    {%- endfor -%}
    {%- endfor -%}
  ]
}
</script>
