{%- elsif template.name == 'page' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "@id": {{ shop.url | append: page.url | append: "#breadcrumb" | json }},
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Prints With Passion", "item": {{ shop.url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ page.title | strip_html | json }}, "item": {{ shop.url | append: page.url | json }} }
        ]
      }{%- if page.handle contains 'guide' -%},
      {
        "@type": "Article",
        "@id": {{ shop.url | append: page.url | append: "#article" | json }},
        "headline": {{ page.title | strip_html | truncate: 110, "" | json }},
        "description": {{ page_description | default: page.title | strip_html | truncate: 158, "" | json }},
        "url": {{ shop.url | append: page.url | json }},
        "author": { "@type": "Organization", "name": "Prints With Passion Studio Curatorial Team", "url": {{ shop.url | json }} },
        "publisher": { "@id": "https://printswithpassion.com/#organization" },
        "isPartOf": { "@id": "https://printswithpassion.com/#website" }
      }{%- endif -%}
    ]
  }
  </script>
{%- elsif template.name == 'article' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "@id": {{ shop.url | append: article.url | append: "#breadcrumb" | json }},
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Prints With Passion", "item": {{ shop.url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ blog.title | default: "Interior & Setup Guides" | json }}, "item": {{ shop.url | append: blog.url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ shop.url | append: article.url | json }} }
        ]
      },
      {
        "@type": "BlogPosting",
        "@id": {{ shop.url | append: article.url | append: "#article" | json }},
        "mainEntityOfPage": { "@type": "WebPage", "@id": {{ shop.url | append: article.url | json }} },
        "headline": {{ article.title | truncate: 110, "" | json }},
        "name": {{ article.title | json }},
        "description": {{ article.excerpt_or_content | strip_html | strip | truncate: 160, "" | json }},
        "url": {{ shop.url | append: article.url | json }},
        "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%SZ" | json }},
        "dateModified": {{ article.updated_at | default: article.published_at | date: "%Y-%m-%dT%H:%M:%SZ" | json }},
        "author": { "@type": "Organization", "name": {{ article.author | default: "Prints With Passion Studio Curatorial Team" | json }}, "url": {{ shop.url | json }} },
        "publisher": {
          "@type": "Organization",
          "@id": "https://printswithpassion.com/#organization",
          "name": "Prints With Passion",
          "url": {{ shop.url | json }},
          "logo": { "@type": "ImageObject", "url": "https://cdn.shopify.com/s/files/1/0726/5039/1863/files/pwp_editorial_gallery_favicon_crest.jpg?v=1793472427" }
        }{%- if article.image -%},
        "image": {
          "@type": "ImageObject",
          "url": {{ article.image | img_url: '1200x' | prepend: "https:" | json }},
          "contentUrl": {{ article.image | img_url: '2048x' | prepend: "https:" | json }},
          "name": {{ article.image.alt | default: article.title | json }},
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "acquireLicensePage": "https://printswithpassion.com/pages/free-4k-wallpapers",
          "creditText": "Prints With Passion Studio",
          "copyrightNotice": "© Prints With Passion",
          "creator": { "@type": "Organization", "name": "Prints With Passion" }
        }
        {%- endif -%}
      }
    ]
  }
  </script>
{%- endif -%}
