<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" type="image/svg+xml" href="{{ 'pwp-gallery-favicon.svg' | asset_url }}">
<link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0726/5039/1863/files/pwp_editorial_gallery_favicon_crest.jpg?v=1793472427&width=32">
<link rel="apple-touch-icon" sizes="180x180" href="https://cdn.shopify.com/s/files/1/0726/5039/1863/files/pwp_editorial_gallery_favicon_crest.jpg?v=1793472427&width=180">
<style id="pwp-editorial-gallery-minimalist">
  :root {
    --pwp-bg: #F6F4EF;
    --pwp-bg-elevated: #EBE7DF;
    --pwp-card: #FCFBF9;
    --pwp-ink: #111110;
    --pwp-ink-secondary: #3F3E3A;
    --pwp-ink-muted: #686660;
    --pwp-accent: #1B3B8B;
    --pwp-accent-hover: #112761;
    --pwp-border: #DEDAD0;
    --pwp-font-display: 'Cormorant Garamond', Georgia, serif;
    --pwp-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --pwp-ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Global Gallery Alabaster Ground & Typography */
  html, body, #MainContent, .main-content {
    background-color: var(--pwp-bg) !important;
    color: var(--pwp-ink) !important;
    font-family: var(--pwp-font-sans) !important;
  }

  h1, h2, h3, .h1, .h2, .h3,
  .home-section-title,
  .sorting-collections__head h2,
  .carousel-products__head h2,
  .collection-head h1,
  .product-page-info__title h1 {
    font-family: var(--pwp-font-display) !important;
    font-weight: 600 !important;
    letter-spacing: -0.03em !important;
    color: var(--pwp-ink) !important;
  }

  /* High-Contrast Keyboard Focus Rings (WCAG AAA) */
  :focus-visible {
    outline: 3px solid var(--pwp-accent) !important;
    outline-offset: 2px !important;
  }

  /* Top Announcement Utility Bar */
  .header__tape,
  .announcement-bar {
    background-color: var(--pwp-ink) !important;
    color: var(--pwp-bg) !important;
    font-family: var(--pwp-font-sans) !important;
    font-size: 12.5px !important;
    letter-spacing: 0.02em !important;
    border-bottom: 1px solid #282825 !important;
  }
  .announcement-bar .new-text {
    color: #F6F4EF !important;
    font-weight: 600 !important;
  }
  .announcement-bar .pwp-tape-sep {
    opacity: 0.4;
    margin: 0 10px;
  }

  /* Storefront Header & Navigation */
  header.header,
  #shopify-section-header,
  .header__line-top,
  .header__line-bottom {
    background-color: var(--pwp-bg) !important;
    border-color: var(--pwp-border) !important;
  }
  .header__line-top {
    border-bottom: 1px solid var(--pwp-border) !important;
  }
  .menu__item > a,
  .header__nav a {
    font-family: var(--pwp-font-sans) !important;
    font-weight: 600 !important;
    color: var(--pwp-ink) !important;
    letter-spacing: -0.01em !important;
  }
  .menu__item > a:hover {
    color: var(--pwp-accent) !important;
  }

  /* New Editorial Gallery Minimalist Logo Lockup */
  .pwp-gallery-logo-wrap {
    display: inline-flex !important;
    align-items: center !important;
    width: auto !important;
    min-width: 215px !important;
  }
  .pwp-gallery-logo-link {
    display: inline-flex !important;
    align-items: center !important;
    gap: 11px !important;
    text-decoration: none !important;
    color: var(--pwp-ink) !important;
  }
  .pwp-gallery-logo-seal {
    position: relative !important;
    width: 38px !important;
    height: 38px !important;
    background: var(--pwp-ink) !important;
    border: 1px solid var(--pwp-ink) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
  }
  .pwp-gallery-logo-seal::before {
    content: '' !important;
    position: absolute !important;
    inset: 3px !important;
    border: 1px solid rgba(246, 244, 239, 0.78) !important;
    pointer-events: none !important;
  }
  .pwp-gallery-logo-seal__inner {
    font-family: var(--pwp-font-display) !important;
    font-size: 24px !important;
    font-weight: 600 !important;
    color: #F6F4EF !important;
    line-height: 1 !important;
  }
  .pwp-gallery-logo-seal__corner {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    width: 8px !important;
    height: 8px !important;
    background: var(--pwp-accent) !important;
  }
  .pwp-gallery-logo-text {
    display: flex !important;
    flex-direction: column !important;
    line-height: 1.05 !important;
    text-align: left !important;
  }
  .pwp-gallery-logo-wordmark {
    font-family: var(--pwp-font-display) !important;
    font-size: 22px !important;
    font-weight: 600 !important;
    letter-spacing: -0.025em !important;
    color: var(--pwp-ink) !important;
    white-space: nowrap !important;
  }
  .pwp-gallery-logo-sub {
    font-family: var(--pwp-font-sans) !important;
    font-size: 8.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.16em !important;
    color: var(--pwp-ink-muted) !important;
    margin-top: 2px !important;
    white-space: nowrap !important;
  }
  @media (max-width: 767px) {
    .pwp-gallery-logo-wrap {
      min-width: 170px !important;
    }
    .pwp-gallery-logo-seal {
      width: 32px !important;
      height: 32px !important;
    }
    .pwp-gallery-logo-seal__inner {
      font-size: 20px !important;
    }
    .pwp-gallery-logo-wordmark {
      font-size: 18px !important;
    }
    .pwp-gallery-logo-sub {
      font-size: 7.5px !important;
    }
  }

  /* ==========================================================================
     EDITORIAL GALLERY MINIMALIST HERO & CURATORIAL SPLIT-CURTAIN STAGE
     ========================================================================== */
  .pwp-gallery-hero {
    background: var(--pwp-bg);
    border-bottom: 1px solid var(--pwp-border);
    padding: 40px 0 64px;
  }
  .pwp-gallery-hero__container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .pwp-gallery-hero__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 44px;
    align-items: center;
  }
  .pwp-gallery-hero__title {
    font-family: var(--pwp-font-display) !important;
    font-size: clamp(40px, 4.8vw, 68px) !important;
    font-weight: 600 !important;
    line-height: 0.94 !important;
    letter-spacing: -0.035em !important;
    color: var(--pwp-ink) !important;
    margin: 0 0 20px 0 !important;
    max-width: 24ch;
  }
  .pwp-gallery-hero__lead {
    font-size: 16.5px !important;
    line-height: 1.58 !important;
    color: var(--pwp-ink-secondary) !important;
    margin: 0 0 28px 0 !important;
    max-width: 52ch;
  }
  .pwp-gallery-hero__cta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .pwp-btn-primary {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 52px !important;
    padding: 0 28px !important;
    line-height: 1.2 !important;
    background: var(--pwp-accent) !important;
    color: #FFFFFF !important;
    font-family: var(--pwp-font-sans) !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    border: 1px solid var(--pwp-accent) !important;
    border-radius: 0 !important;
    transition: background-color 160ms ease, transform 120ms var(--pwp-ease-out);
  }
  .pwp-btn-primary:hover {
    background: var(--pwp-accent-hover) !important;
    color: #FFFFFF !important;
  }
  .pwp-btn-primary:active {
    transform: scale(0.97);
  }
  .pwp-btn-secondary {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 52px !important;
    padding: 0 22px !important;
    line-height: 1.2 !important;
    background: var(--pwp-card) !important;
    color: var(--pwp-ink) !important;
    font-family: var(--pwp-font-sans) !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    border: 1px solid var(--pwp-ink) !important;
    border-radius: 0 !important;
    transition: background-color 160ms ease, transform 120ms var(--pwp-ease-out);
  }
  .pwp-btn-secondary:hover {
    background: var(--pwp-bg-elevated) !important;
    color: var(--pwp-ink) !important;
  }
  .pwp-gallery-hero__specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-top: 22px;
    border-top: 1px solid var(--pwp-border);
    font-variant-numeric: tabular-nums;
  }
  .pwp-spec-val {
    font-family: var(--pwp-font-display);
    font-size: 25px;
    font-weight: 600;
    color: var(--pwp-ink);
    display: block;
    line-height: 1.1;
  }
  .pwp-spec-lbl {
    font-size: 12.5px;
    color: var(--pwp-ink-muted);
    margin-top: 4px;
    display: block;
  }

  /* Right Column Curatorial Split-Curtain & 3x Loupe Box */
  .pwp-curatorial-box {
    background: var(--pwp-card);
    border: 1px solid var(--pwp-border);
    overflow: hidden;
  }
  .pwp-curatorial-top {
    padding: 11px 16px;
    border-bottom: 1px solid var(--pwp-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pwp-plaque-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--pwp-ink-secondary);
  }
  .pwp-plaque-meta strong {
    color: var(--pwp-ink);
    font-weight: 700;
  }
  .pwp-mode-pills {
    display: inline-flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pwp-mode-chip {
    appearance: none;
    border: 1px solid var(--pwp-border);
    background: var(--pwp-bg);
    color: var(--pwp-ink);
    font-family: var(--pwp-font-sans);
    font-size: 12px;
    font-weight: 600;
    min-height: 36px;
    padding: 4px 10px;
    border-radius: 0;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .pwp-mode-chip.is-active {
    background: var(--pwp-ink);
    color: var(--pwp-bg);
    border-color: var(--pwp-ink);
  }
  .pwp-stage-frame {
    position: relative;
    aspect-ratio: 16 / 10.5;
    width: 100%;
    background: var(--pwp-bg-elevated);
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
  }
  .pwp-stage-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pwp-stage-layer img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
    pointer-events: none !important;
  }
  .pwp-stage-layer--front {
    clip-path: inset(0 0 0 var(--pwp-split, 52%));
  }
  .pwp-split-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pwp-split, 52%);
    width: 2px;
    background: var(--pwp-ink);
    z-index: 10;
    cursor: ew-resize;
    transform: translateX(-50%);
  }
  .pwp-split-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 42px;
    height: 42px;
    background: var(--pwp-card);
    color: var(--pwp-ink);
    border: 1.5px solid var(--pwp-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
  }
  .pwp-corner-tag {
    position: absolute;
    bottom: 12px;
    z-index: 8;
    background: var(--pwp-card);
    color: var(--pwp-ink);
    border: 1px solid var(--pwp-border);
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 700;
    pointer-events: none;
  }
  .pwp-corner-tag--left { left: 12px; }
  .pwp-corner-tag--right { right: 12px; }
  .pwp-loupe-lens {
    position: absolute;
    width: 185px;
    height: 185px;
    border-radius: 50%;
    border: 2px solid var(--pwp-card);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 0 1px var(--pwp-ink);
    background-repeat: no-repeat;
    background-size: 280% 280%;
    pointer-events: none;
    z-index: 15;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
    transition: opacity 180ms ease, transform 180ms var(--pwp-ease-out);
  }
  .pwp-stage-frame.loupe-active {
    cursor: crosshair;
  }
  .pwp-stage-frame.loupe-active:hover .pwp-loupe-lens,
  .pwp-stage-frame.loupe-active.loupe-pinned .pwp-loupe-lens {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .pwp-loupe-label {
    position: absolute;
    bottom: -24px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pwp-ink);
    color: var(--pwp-bg);
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    white-space: nowrap;
  }
  .pwp-curatorial-bottom {
    padding: 13px 16px;
    border-top: 1px solid var(--pwp-border);
    background: var(--pwp-card);
  }
  .pwp-suite-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }
  .pwp-suite-caption {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--pwp-ink);
  }
  .pwp-suite-hint {
    font-size: 11.5px;
    color: var(--pwp-ink-muted);
  }
  .pwp-suite-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 8px;
    align-items: stretch;
  }
  .pwp-suite-btn {
    appearance: none;
    border: 1px solid var(--pwp-border);
    background: var(--pwp-bg);
    color: var(--pwp-ink);
    font-family: var(--pwp-font-sans);
    padding: 8px 11px;
    min-height: 46px;
    border-radius: 0;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
  }
  .pwp-suite-btn.is-active {
    background: var(--pwp-ink);
    color: var(--pwp-bg);
    border-color: var(--pwp-ink);
  }
  .pwp-suite-btn__top {
    font-size: 12px;
    font-weight: 700;
    display: flex;
    justify-content: space-between;
  }
  .pwp-suite-btn__sub {
    font-size: 10.5px;
    opacity: 0.78;
  }
  .pwp-suite-action-link {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1.2 !important;
    background: var(--pwp-accent) !important;
    color: #FFFFFF !important;
    font-family: var(--pwp-font-sans);
    font-size: 12.5px;
    font-weight: 700;
    padding: 0 15px;
    min-height: 46px;
    text-decoration: none !important;
    white-space: nowrap;
  }
  .pwp-suite-action-link:hover {
    background: var(--pwp-accent-hover) !important;
    color: #FFFFFF !important;
  }

  /* Five Tactile Substrates Craft Proof Section */
  .pwp-craft-section {
    max-width: 1380px;
    margin: 0 auto;
    padding: 48px 24px;
    border-top: 1px solid var(--pwp-border);
    border-bottom: 1px solid var(--pwp-border);
    background: var(--pwp-bg);
  }
  .pwp-craft-grid {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: 44px;
    align-items: center;
  }
  .pwp-craft-title {
    font-family: var(--pwp-font-display) !important;
    font-size: clamp(32px, 3.4vw, 48px) !important;
    margin: 0 0 10px 0 !important;
  }
  .pwp-craft-sub {
    font-size: 15.5px;
    color: var(--pwp-ink-secondary);
    margin: 0 0 24px 0;
  }
  .pwp-craft-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pwp-craft-card {
    background: var(--pwp-card);
    border: 1px solid var(--pwp-border);
    padding: 20px;
  }
  .pwp-craft-card h3 {
    font-family: var(--pwp-font-display) !important;
    font-size: 21px !important;
    margin: 0 0 6px 0 !important;
  }
  .pwp-craft-card p {
    font-size: 13.5px;
    color: var(--pwp-ink-secondary);
    margin: 0;
    line-height: 1.5;
  }
  .pwp-craft-img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--pwp-border);
  }

  /* Collection Tabs, Product Cards & Buttons (Editorial Gallery Minimalist) */
  .sorting-collections__head a,
  .tabs__btn {
    font-family: var(--pwp-font-sans) !important;
    font-weight: 600 !important;
    border-radius: 0 !important;
  }
  .product-collection {
    background: var(--pwp-card) !important;
    border: 1px solid var(--pwp-border) !important;
    padding: 12px !important;
    transition: border-color 180ms ease !important;
  }
  .product-collection:hover {
    border-color: var(--pwp-ink) !important;
  }
  .product-collection__title h4,
  .product-collection__title a {
    font-family: var(--pwp-font-display) !important;
    font-size: 19px !important;
    font-weight: 600 !important;
    line-height: 1.2 !important;
    color: var(--pwp-ink) !important;
  }
  .price, .price span {
    font-family: var(--pwp-font-sans) !important;
    font-variant-numeric: tabular-nums !important;
    font-weight: 700 !important;
    color: var(--pwp-ink) !important;
  }
  .btn,
  .product-page-info__button-add-to-cart .btn,
  .product-collection__buttons .btn {
    border-radius: 0 !important;
    font-family: var(--pwp-font-sans) !important;
    font-weight: 700 !important;
    letter-spacing: 0.01em !important;
  }
  .product-page-info__button-add-to-cart .btn {
    background-color: var(--pwp-accent) !important;
    border-color: var(--pwp-accent) !important;
    color: #FFFFFF !important;
    min-height: 54px !important;
  }
  .product-page-info__button-add-to-cart .btn:hover {
    background-color: var(--pwp-accent-hover) !important;
    border-color: var(--pwp-accent-hover) !important;
  }

  /* Footer Gallery Elevation */
  footer.footer,
  #shopify-section-footer {
    background-color: var(--pwp-bg-elevated) !important;
    border-top: 1px solid var(--pwp-border) !important;
    color: var(--pwp-ink) !important;
  }

  @media (max-width: 1024px) {
    .pwp-gallery-hero__grid,
    .pwp-craft-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .pwp-suite-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .pwp-suite-grid,
    .pwp-craft-cards {
      grid-template-columns: 1fr;
    }
    .pwp-gallery-hero {
      padding: 24px 0 40px;
    }
    .pwp-mode-pills {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      -webkit-overflow-scrolling: touch;
    }
    .pwp-mode-chip {
      flex-shrink: 0;
      min-height: 42px;
      padding: 6px 12px;
    }
    input[type="search"],
    input[type="text"],
    input[type="email"],
    select {
      font-size: 16px !important;
    }
  }
  @media (min-width: 1600px) {
    .pwp-gallery-hero__container {
      max-width: 1520px;
    }
  }
  /* Geo-Targeted Studio Pill */
  .pwp-geo-studio-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--pwp-font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--pwp-ink);
    background: var(--pwp-card);
    border: 1px solid var(--pwp-border);
    padding: 6px 12px;
    margin-bottom: 16px;
  }
  /* Touch vs Mouse Pointer Adaptation */
  @media (hover: none) and (pointer: coarse) {
    .pwp-split-knob {
      width: 48px !important;
      height: 48px !important;
      font-size: 18px !important;
    }
    .pwp-suite-btn {
      min-height: 52px !important;
    }
  }
  /* iOS Safe Area Bottom Bar Adaptation */
  html[data-pwp-os="ios"] .footbar {
    padding-bottom: env(safe-area-inset-bottom, 12px) !important;
  }
  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
<meta name="theme-color" content="#F6F4EF">
<script id="pwp-curatorial-hero-engine">
(function() {
  // 1. Dynamic Device, Input Modality, OS Platform & Location Detection
  function detectEnvironment() {
    var docEl = document.documentElement;
    var w = window.innerWidth || 1280;
    var device = w <= 640 ? 'mobile' : (w <= 1024 ? 'tablet' : (w >= 1600 ? 'ultrawide' : 'desktop'));
    var isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || (window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
    var ua = navigator.userAgent || '';
    var os = 'other';
    if (/iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) {
      os = 'ios';
    } else if (/Android/i.test(ua)) {
      os = 'android';
    } else if (/Mac/i.test(navigator.platform || ua)) {
      os = 'macos';
    } else if (/Win/i.test(navigator.platform || ua)) {
      os = 'windows';
    } else if (/Linux/i.test(navigator.platform || ua)) {
      os = 'linux';
    }
    docEl.setAttribute('data-pwp-device', device);
    docEl.setAttribute('data-pwp-input', isTouch ? 'touch' : 'mouse');
    docEl.setAttribute('data-pwp-os', os);
    docEl.setAttribute('data-pwp-dpr', String(Math.min(3, Math.round(window.devicePixelRatio || 1))));

    var hintEl = document.getElementById('pwp-hero-modality-hint');
    if (hintEl) {
      hintEl.textContent = isTouch
        ? 'Touch & drag split curtain or tap a medium below'
        : 'Drag slider above or select a substrate below';
    }

    var country = (window.Shopify && window.Shopify.country) || docEl.getAttribute('data-pwp-country') || '';
    if (!country) {
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (tz.indexOf('London') !== -1 || tz.indexOf('Belfast') !== -1) country = 'GB';
        else if (tz.indexOf('Toronto') !== -1 || tz.indexOf('Vancouver') !== -1) country = 'CA';
        else if (tz.indexOf('Zurich') !== -1) country = 'CH';
        else if (tz.indexOf('Sydney') !== -1 || tz.indexOf('Melbourne') !== -1) country = 'AU';
        else if (tz.indexOf('Europe/') === 0) country = 'EU';
        else country = 'US';
      } catch (e) { country = 'US'; }
    }
    docEl.setAttribute('data-pwp-country', country);
  }

  detectEnvironment();
  window.addEventListener('resize', detectEnvironment, { passive: true });

  // 2. Zero-Visual-Change Deferred Hover Image Hydration (Cuts Initial Grid Bandwidth by 50%)
  function hydrateHoverImg(img) {
    if (!img || img.dataset.pwpHydrated) return;
    img.dataset.pwpHydrated = '1';
    var hSrcset = img.getAttribute('data-hover-srcset');
    var hSizes = img.getAttribute('data-hover-sizes');
    var hSrc = img.getAttribute('data-hover-src');
    if (hSizes) img.setAttribute('sizes', hSizes);
    if (hSrcset) img.setAttribute('srcset', hSrcset);
    if (hSrc) img.setAttribute('src', hSrc);
  }

  document.addEventListener('pointerenter', function(e) {
    if (!e.target || !e.target.closest) return;
    var card = e.target.closest('.product-collection, [data-js-product-image]');
    if (card) {
      var hoverImg = card.querySelector('.pwp-hover-lifestyle-img');
      if (hoverImg) hydrateHoverImg(hoverImg);
    }
  }, true);

  document.addEventListener('mouseover', function(e) {
    if (!e.target || !e.target.closest) return;
    var card = e.target.closest('.product-collection, [data-js-product-image]');
    if (card) {
      var hoverImg = card.querySelector('.pwp-hover-lifestyle-img');
      if (hoverImg) hydrateHoverImg(hoverImg);
    }
  }, { passive: true });

  // Pre-hydrate visible hover images during browser idle time on desktop (hover-capable) devices after primary images finish loading
  window.addEventListener('load', function() {
    if (window.matchMedia && window.matchMedia('(hover: hover)').matches) {
      var scheduleIdle = window.requestIdleCallback || function(cb) { setTimeout(cb, 250); };
      scheduleIdle(function() {
        if ('IntersectionObserver' in window) {
          var hoverObserver = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                hydrateHoverImg(entry.target);
                obs.unobserve(entry.target);
              }
            });
          }, { rootMargin: '250px 0px' });
          document.querySelectorAll('.pwp-hover-lifestyle-img:not([data-pwp-hydrated])').forEach(function(img) {
            hoverObserver.observe(img);
          });
        }
      });
    }
  });

  function buildSrcset(baseUrl) {
    if (!baseUrl) return '';
    var sep = baseUrl.indexOf('?') !== -1 ? '&' : '?';
    return baseUrl + sep + 'width=600 600w, ' + baseUrl + sep + 'width=900 900w, ' + baseUrl + sep + 'width=1400 1400w';
  }

  function ensureLoupeBg(lens) {
    if (!lens) return;
    var bgUrl = lens.getAttribute('data-loupe-bg');
    if (bgUrl && !lens.style.backgroundImage) {
      lens.style.backgroundImage = "url('" + bgUrl + "')";
    }
  }

  function initPwpCuratorialHero() {
    detectEnvironment();
    var stage = document.getElementById('pwp-hero-stage-frame');
    if (!stage || stage.dataset.pwpBound) return;
    stage.dataset.pwpBound = '1';

    var handle = document.getElementById('pwp-hero-split-handle');
    var lens = document.getElementById('pwp-hero-loupe-lens');
    var tagLeft = document.getElementById('pwp-hero-tag-left');
    var tagRight = document.getElementById('pwp-hero-tag-right');
    var currentMode = 'split';
    var splitPct = 52;
    var dragging = false;

    function setSplit(pct) {
      splitPct = Math.max(0, Math.min(100, pct));
      stage.style.setProperty('--pwp-split', splitPct + '%');
      if (handle) handle.setAttribute('aria-valuenow', String(Math.round(splitPct)));
    }

    function setMode(mode) {
      currentMode = mode;
      document.querySelectorAll('[data-pwp-mode]').forEach(function(b) {
        b.classList.toggle('is-active', b.getAttribute('data-pwp-mode') === mode);
      });
      stage.classList.toggle('loupe-active', mode === 'loupe');
      stage.classList.toggle('loupe-pinned', mode === 'loupe');

      if (mode === 'split') {
        setSplit(50);
        if (handle) handle.style.display = 'block';
        if (tagLeft) tagLeft.style.display = 'block';
        if (tagRight) tagRight.style.display = 'block';
      } else if (mode === 'room') {
        setSplit(100);
        if (handle) handle.style.display = 'none';
        if (tagLeft) tagLeft.style.display = 'block';
        if (tagRight) tagRight.style.display = 'none';
      } else if (mode === 'studio') {
        setSplit(0);
        if (handle) handle.style.display = 'none';
        if (tagLeft) tagLeft.style.display = 'none';
        if (tagRight) tagRight.style.display = 'block';
      } else if (mode === 'loupe') {
        setSplit(0);
        if (handle) handle.style.display = 'none';
        if (lens) {
          ensureLoupeBg(lens);
          lens.style.left = '52%';
          lens.style.top = '48%';
          lens.style.backgroundPosition = '52% 48%';
        }
      }
    }

    document.addEventListener('click', function(e) {
      var modeBtn = e.target.closest('[data-pwp-mode]');
      if (modeBtn) {
        setMode(modeBtn.getAttribute('data-pwp-mode'));
        return;
      }
      var suiteBtn = e.target.closest('[data-pwp-suite]');
      if (suiteBtn) {
        document.querySelectorAll('[data-pwp-suite]').forEach(function(b) {
          b.classList.toggle('is-active', b === suiteBtn);
        });
        var roomImg = document.getElementById('pwp-hero-img-room');
        var frontImg = document.getElementById('pwp-hero-img-front');
        var titleEl = document.getElementById('pwp-hero-plaque-title');
        var bpEl = document.getElementById('pwp-hero-plaque-bp');
        var ctaEl = document.getElementById('pwp-hero-suite-cta');
        var rUrl = suiteBtn.getAttribute('data-room');
        var fUrl = suiteBtn.getAttribute('data-front');
        if (roomImg && rUrl) {
          roomImg.src = rUrl + '&width=1200';
          roomImg.srcset = buildSrcset(rUrl);
        }
        if (frontImg && fUrl) {
          frontImg.src = fUrl + '&width=1200';
          frontImg.srcset = buildSrcset(fUrl);
        }
        if (lens && fUrl) {
          var sep = fUrl.indexOf('?') !== -1 ? '&' : '?';
          var hiRes = fUrl + sep + 'width=2048';
          lens.setAttribute('data-loupe-bg', hiRes);
          if (currentMode === 'loupe' || lens.style.backgroundImage) {
            lens.style.backgroundImage = "url('" + hiRes + "')";
          }
        }
        if (titleEl) titleEl.textContent = suiteBtn.getAttribute('data-title');
        if (bpEl) bpEl.textContent = suiteBtn.getAttribute('data-bp');
        if (ctaEl) {
          ctaEl.href = suiteBtn.getAttribute('data-url');
          ctaEl.textContent = suiteBtn.getAttribute('data-cta');
        }
      }
    });

    function updatePointer(clientX, clientY) {
      var rect = stage.getBoundingClientRect();
      var x = ((clientX - rect.left) / rect.width) * 100;
      var y = ((clientY - rect.top) / rect.height) * 100;
      if (currentMode === 'loupe' && lens) {
        ensureLoupeBg(lens);
        stage.classList.remove('loupe-pinned');
        var cx = Math.max(8, Math.min(92, x));
        var cy = Math.max(8, Math.min(92, y));
        lens.style.left = cx + '%';
        lens.style.top = cy + '%';
        lens.style.backgroundPosition = cx + '% ' + cy + '%';
        return;
      }
      if (dragging && currentMode === 'split') {
        setSplit(x);
      }
    }

    stage.addEventListener('pointerdown', function(e) {
      if (currentMode === 'loupe') return;
      if (currentMode !== 'split') setMode('split');
      dragging = true;
      if (stage.setPointerCapture) stage.setPointerCapture(e.pointerId);
      updatePointer(e.clientX, e.clientY);
    });
    stage.addEventListener('pointermove', function(e) {
      if (currentMode === 'loupe' || dragging) {
        updatePointer(e.clientX, e.clientY);
      }
    });
    stage.addEventListener('pointerup', function() { dragging = false; });
    stage.addEventListener('pointercancel', function() { dragging = false; });

    if (handle) {
      handle.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); setSplit(splitPct - 5); }
        if (e.key === 'ArrowRight') { e.preventDefault(); setSplit(splitPct + 5); }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPwpCuratorialHero);
  } else {
    initPwpCuratorialHero();
  }
})();
</script>
